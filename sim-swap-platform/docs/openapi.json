  "components": {
    "schemas": {
      "AssessmentIn": {
        "properties": {
          "subscriber": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Subscriber"
          },
          "action_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Action Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "sim_replacement",
              "login",
              "recovery",
              "beneficiary_change",
              "transaction"
            ],
            "title": "Action"
          },
          "mode": {
            "type": "string",
            "enum": [
              "pre_replacement",
              "post_replacement"
            ],
            "title": "Mode",
            "default": "post_replacement"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "amount": {
            "type": "number",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Amount",
            "default": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "ETB"
          },
          "beneficiary_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Beneficiary Id"
          },
          "trusted_device": {
            "type": "boolean",
            "title": "Trusted Device",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subscriber",
          "action_id",
          "action"
        ],
        "title": "AssessmentIn"
      },
      "Attributes": {
        "properties": {
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
